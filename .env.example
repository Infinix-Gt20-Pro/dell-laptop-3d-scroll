# Classic Computers — Environment Variables Template
# =====================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# Server
PORT=3000

# Admin panel secret (change this to a long random string)
ADMIN_SECRET=change-me-to-something-long-and-random

# Password hashing pepper (change and keep secret)
PASSWORD_PEPPER=change-me-to-another-random-string

# InsForge Backend (auto-filled by: npx @insforge/cli link)
# These are stored in .insforge/project.json (gitignored)
# INSFORGE_PROJECT_ID=ffd13b56-a2a2-4ab5-804e-152bbe755f2d
# INSFORGE_APP_KEY=nsr7uvah
# INSFORGE_REGION=us-east
# INSFORGE_OSS_HOST=https://nsr7uvah.us-east.insforge.app
